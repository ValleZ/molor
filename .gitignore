# Large downloaded or derived artifacts
.venv/
.venv-pom/
vendor/olfaction/
vendor/zenodo/
# OpenPOM clone: 10 x 25 MB ensemble checkpoints, re-cloneable
vendor/openpom/
artifacts/esm_cache/
artifacts/panel_embeddings.npy
artifacts/*.log

# Keep the small, reproducibility-critical artifacts:
!artifacts/receptors.tsv
!artifacts/manifest.json

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build outputs: regenerated in seconds from the library store plus the
# template, so the inputs are versioned and these are not.
artifacts/viewer_data*.json
artifacts/receptor_atlas*.html
artifacts/maps*/
