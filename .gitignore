# Large downloaded or derived artifacts
.venv/
.venv-pom/
.venv-pyrfume/
.venv-unimol/
vendor/olfaction/
vendor/zenodo/
# OpenPOM clone: 10 x 25 MB ensemble checkpoints, re-cloneable
vendor/openpom/
# Dense Sense clone: 4.1 GB of ensemble checkpoints, re-cloneable
vendor/densesense/
vendor/unimol*/
artifacts/esm_cache/
artifacts/panel_embeddings.npy
artifacts/*.log

# Keep the small, reproducibility-critical artifacts:
!artifacts/receptors.tsv
!artifacts/manifest.json

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build outputs: regenerated in seconds from the library store plus the
# template, so the inputs are versioned and these are not.
artifacts/viewer_data*.json
artifacts/receptor_atlas*.html
artifacts/molor_public*.html
artifacts/simplify*.html
artifacts/simplify_data.json
artifacts/maps*/
# The deployed copy of the atlas is versioned in the valkon.us repo, which is
# how the site is published; keeping a second copy here only doubles the churn.

# Throwaway formula experiments: scripts/try_formula.py writes here and
# nothing in it is a result worth keeping.
artifacts/temp/

# The perfumer's own writing, kept out of this repository deliberately. These
# are the written smelling impressions and the formula book with its verdicts;
# they were the inputs to several results here and are nobody else's business.
# What stays is derived and was explicitly cleared for publication:
# data/inventory/inventory.csv carries the use levels, threshold figures,
# families and volatility classes with no prose at all.
library/input/impressions.tsv
data/inventory/perfumery_inventory.csv
data/formulas/recipes.md
data/formulas/parsed.json
