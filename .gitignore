# Large downloaded or derived artifacts
.venv/
.venv-pom/
.venv-pyrfume/
.venv-unimol/
vendor/olfaction/
vendor/zenodo/
# IFRA standards workbooks and PDFs: IFRA restricts redistribution, so the
# source documents stay here and only the derived tables are committed.
vendor/ifra/
# The Fraterworks catalogue snapshot and the gap list derived from it: 9 MB of
# scraped supplier data, re-fetchable with scripts/fetch_fraterworks.py. They
# used to live in the valkon.us checkout, which is how they got committed to a
# static site; scripts/ audit and diff them from here now.
vendor/fraterworks/
# OpenPOM clone: 10 x 25 MB ensemble checkpoints, re-cloneable
vendor/openpom/
# Dense Sense clone: 4.1 GB of ensemble checkpoints, re-cloneable
vendor/densesense/
vendor/unimol*/
artifacts/esm_cache/
artifacts/panel_embeddings.npy
artifacts/*.log
# The receptor store's own backup: `orvector library add` copies the previous
# vectors beside the live ones before an append, and the CSV rebuilds them.
artifacts/library/_backup_*/

# Keep the small, reproducibility-critical artifacts:
!artifacts/receptors.tsv
!artifacts/manifest.json

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build outputs: regenerated in seconds from the library store plus the
# template, so the inputs are versioned and these are not.
artifacts/viewer_data*.json
artifacts/receptor_atlas*.html
artifacts/molor_public*.html
artifacts/simplify*.html
artifacts/simplify_data.json
artifacts/maps*/
# The deployed copy of the atlas is versioned in the valkon.us repo, which is
# how the site is published; keeping a second copy here only doubles the churn.

# Throwaway formula experiments: scripts/try_formula.py writes here and
# nothing in it is a result worth keeping.
artifacts/temp/

# The perfumer's own writing, kept out of this repository deliberately. These
# are the written smelling impressions, the formula book with its verdicts, and
# the mix log with its shelf slots and its own per-mix verdicts; they were the
# inputs to several results here and are nobody else's business.
# What stays is derived and was explicitly cleared for publication:
# data/inventory/inventory.csv carries the use levels, threshold figures,
# families and volatility classes with no prose at all.
library/input/impressions.tsv
data/inventory/perfumery_inventory.csv
data/formulas/recipes.md
data/formulas/parsed.json
data/formulas/mixes.csv

# Web-session answers for boiling points: pasted output, not project data
# until merge_bp.py has scored its controls and written boiling_points.csv.
data/inventory/bp_requests/reply_*.csv
